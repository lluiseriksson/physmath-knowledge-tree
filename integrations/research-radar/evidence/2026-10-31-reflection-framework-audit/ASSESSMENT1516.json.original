  "accepted_conditions": [
    "The exact retained domain is a full-dimensional compact convex product in distinct independent raw blocks.",
    "The exact real potential is C2 near that product and Hess H >= m I with m > 0.",
    "Actual raw Hessian blocks have finite graph range R_H and both row and column block-norm sums bounded by B_H.",
    "The observables have full Euclidean Lipschitz bounds and fixed coordinate-gradient carriers.",
    "For uniformity, m, B_H, R_H and observable Lipschitz constants are uniform over the asserted volumes, histories and interpolation parameters.",
    "The history and interpolation parameter are fixed during each autonomous semigroup argument."
  ],
  "findings": [
    {
      "id": "A1",
      "classification": "accepted",
      "topic": "Weighted Hessian and corner signs",
      "finding": "Schur conjugation bound and blockwise normal-cone inequalities give synchronous decay exp(-m s/2). No smooth flow or boundary smoothness is required."
    },
    {
      "id": "A2",
      "classification": "accepted",
      "topic": "Gradient metric and normalization",
      "finding": "The dual norm is |W^-1 grad f|. Pairing with |W grad g| gives spatial decay; sqrt(2) noise yields E(u,v)=integral grad u dot grad v with no extra factor two."
    },
    {
      "id": "A3",
      "classification": "accepted",
      "topic": "Covariance identity and uniform constants",
      "finding": "Finite-volume convergence plus the uniformly integrable gradient bound gives coefficient 2/m, hence 4 gamma^2/a_soft for the assumed primitive bound. Auxiliary diameter and inball constants do not enter the final estimate."
    },
    {
      "id": "F1",
      "classification": "minor_specification",
      "location": "FRAMEWORK1474.md:14",
      "topic": "Literal Słomiński theorem setup",
      "finding": "The printed setup uses square coefficients and a driver of the state dimension, while the note inserts an n by n+1 matrix. A direct application needs bookkeeping.",
      "repair": "Use state (A,q) in U x R, driver (s,B_s), append a zero final coefficient row and initial q=0, and project the strong solution. Domain conditions and bounded Lipschitz coefficients are preserved.",
      "effect": "No new analytic hypothesis; not a material refutation."
    },
    {
      "id": "F2",
      "classification": "minor_specification",
      "location": "REFLECTION1473.md:9",
      "topic": "Finite weights and degenerate carriers",
      "finding": "Finite volume alone does not rule out infinite graph distance or an empty carrier.",
      "repair": "Treat constant observables separately; assume a connected graph or use weights exp(-alpha min(dist(b,S),M)) and let M tend to infinity.",
      "effect": "No material change to the claimed estimate."
    },
    {
      "id": "G1",
      "classification": "material_application_gate",
      "topic": "Actual physical law",
      "finding": "Product geometry, hard-to-soft coercivity, complete inside/exterior Hessian margin, raw-coordinate finite range and uniform block sums, primitive Lipschitz constant and observable transport remain unverified assumptions."
    },
    {
      "id": "G2",
      "classification": "material_application_gate",
      "topic": "History averaging",
      "finding": "The law-of-total-covariance argument is correct, but a conditional bound and even zero bad-history probability leave the covariance of conditional means uncontrolled. A small distance-independent bad probability leaves a distance-independent remainder."
    }
  ],
