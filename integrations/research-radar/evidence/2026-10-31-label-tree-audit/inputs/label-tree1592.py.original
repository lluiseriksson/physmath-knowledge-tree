from pathlib import Path
from itertools import combinations,product
from collections import Counter
import json,math
W=Path('C:/Trabajo/airr/2026-10-31_execution1592')
supports=[{0,1},{1,2},{3},{4,5},{5,6}]
def forest_tree(vertices,edges):
 parent={i:i for i in vertices}
 def root(x):
  while parent[x]!=x:x=parent[x]
  return x
 for i,j in edges:
  x,y=root(i),root(j)
  if x==y:return False
  parent[x]=y
 return len(edges)==len(vertices)-1 and len({root(i) for i in vertices})==1
subsets=0;assignments=0;max_components=0
for mask in range(1,1<<len(supports)):
 if not mask&1:continue
 S=[i for i in range(len(supports)) if mask>>i&1];subsets+=1
 overlap=[(i,j) for i,j in combinations(S,2) if supports[i]&supports[j]]
 components=[];todo=set(S)
 while todo:
  seen={min(todo)}
  while True:
   more=seen|{j for i,j in overlap if i in seen}|{i for i,j in overlap if j in seen}
   if more==seen:break
   seen=more
  components.append(sorted(seen));todo-=seen
 N=len(components);max_components=max(max_components,N)
 internal=[]
 for group in components:
  allowed=[e for e in overlap if e[0] in group and e[1] in group]
  internal.extend(next(list(es) for es in combinations(allowed,len(group)-1) if forest_tree(group,es)))
 unions=[set().union(*(supports[i] for i in group)) for group in components]
 owners=[{x:min(i for i in group if x in supports[i]) for x in U} for group,U in zip(components,unions)]
 keys=set();vertices=list(range(N))
 for T in combinations(list(combinations(vertices,2)),N-1):
  if not forest_tree(vertices,T):continue
  choices=[list(product(sorted(unions[i]),sorted(unions[j]))) for i,j in T]
  for endpoints in product(*choices):
   external=[];decorated=[];occupancy=Counter();external_degrees=Counter()
   for (i,j),(x,y) in zip(T,endpoints):
    v,w=owners[i][x],owners[j][y]
    external.append((v,w));decorated.append((v,w,x,y))
    occupancy[x]+=1;occupancy[y]+=1;external_degrees[v]+=1;external_degrees[w]+=1
   assert forest_tree(S,internal+external)
   key=(tuple(internal),tuple(sorted(decorated)))
   assert key not in keys;keys.add(key)
   degree=Counter(v for e in internal+external for v in e)
   lhs=math.prod(math.factorial(a) for a in occupancy.values())
   middle=math.prod(math.factorial(external_degrees[i]) for i in S)
   rhs=math.prod(math.factorial(degree[i]) for i in S)
   assert lhs<=middle<=rhs
   assignments+=1
out={'scope':'Own exact finite combinatorial test of original-label canonical overlap tree/coordinate-owner injection; no physical source identification',
 'supports':[sorted(x) for x in supports],'root_label':0,'rooted_subsets_checked':subsets,'decorated_assignments_checked':assignments,'max_overlap_components':max_components,
 'tree_and_injection_checks_passed':True,'integer_occupancy_inequalities_passed':True,
 'uniform_source_hypotheses_verified':False,'formal_build':False,'new_assessment':False}
(W/'LABEL-TREE-CHECK1592.json').write_bytes((json.dumps(out,indent=2)+'\n').encode())
print(json.dumps(out))
